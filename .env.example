# Copia este archivo a .env.local y completa los valores.
# .env.local NO se sube a Git.

# URL del proyecto de Supabase.
# Local (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable ("publishable" o "anon"). Es pública por diseño: la
# seguridad la da Row Level Security. NO pongas aquí la clave "secret" ni
# la "service_role".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
